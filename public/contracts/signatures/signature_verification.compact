/**
 * Privacy-Enhanced Signature Verification Contract
 * 
 * This contract implements a privacy-preserving document signing system using:
 * 1. Pedersen Commitments: To hide signer and owner DIDs
 * 2. Nullifiers: To prevent double-signing without revealing signer identity
 * 3. Zero-Knowledge Proofs: For signature verification without exposing DIDs
 * 
 * Privacy Guarantees:
 * - Signer Anonymity: DIDs are never stored in plaintext, only as commitments
 * - Document-Signer Unlinkability: Cannot link specific DIDs to documents
 * - Double-Signing Prevention: Uses nullifiers without revealing signer identity
 * - Multi-Party Privacy: Maintains signer privacy even with multiple signers
 * - Owner Privacy: Document ownership is proven through commitments
 * 
 * Security Features:
 * - Pedersen Commitments: Computationally binding and perfectly hiding
 * - Nullifier Design: Unique per document-signer pair, preventing replay attacks
 * - Zero-Knowledge Proofs: Verify signatures without revealing secret inputs
 * 
 * Usage Notes:
 * - All DIDs should be 32 bytes
 * - Commitments and nullifiers are also 32 bytes
 * - Multi-party signing requires specifying number of required signatures
 */

pragma language_version >= 0.14.0;

import CompactStandardLibrary;

// Document type enum
export enum DocumentType {
    Basic,
    Legal,
    Regulated
}

// Commitment structure for hiding DIDs
struct IdentityCommitment {
    commitment: Bytes<32>,    // Pedersen commitment of DID
    nullifier: Bytes<32>      // Nullifier to prevent double-signing
}

struct DocumentMetadata {
    documentType: DocumentType,
    ownerCommitment: Bytes<32>,  // Commitment instead of raw DID
    multiParty: Field,
    requiredSignatures: Uint<64>,
    signerCount: Uint<64>,
    version: Uint<8>
}

struct SignatureEntry {
    documentHash: Bytes<32>,
    signerCommitment: Bytes<32>,  // Commitment instead of raw DID
    proof: Bytes<32>,
    nullifierHash: Bytes<32>,     // Hash of nullifier to prevent double-signing
    timestamp: Bytes<32>
}

// Ledger state
ledger documents: Map<Bytes<32>, DocumentMetadata>;
ledger signatures: Map<Bytes<32>, SignatureEntry>;
ledger revoked: Set<Bytes<32>>;
ledger versions: Map<Bytes<32>, Uint<64>>;
ledger signerCounts: Map<Bytes<32>, Uint<64>>;
ledger nullifiers: Set<Bytes<32>>;  // Track used nullifiers

witness local_secret_key(): Bytes<32>;

// Generate a Pedersen commitment for a DID
export circuit commit_to_did(did: Bytes<32>): Bytes<32> {
    const sk = local_secret_key();
    const randomness = persistent_hash<Vector<2, Bytes<32>>>([did, sk]);
    const commitment = persistent_hash<Vector<3, Bytes<32>>>([
        pad(32, "did:commit:"),
        did,
        randomness
    ]);
    // Only disclose the commitment, not the secret key or randomness
    return disclose(commitment);
}

// Generate nullifier for preventing double-signing
export circuit generate_nullifier(did: Bytes<32>, documentHash: Bytes<32>): Bytes<32> {
    const sk = local_secret_key();
    const nullifier = persistent_hash<Vector<4, Bytes<32>>>([
        pad(32, "nullifier:"),
        did,
        documentHash,
        sk
    ]);
    // Only disclose the nullifier hash, not the components
    return disclose(nullifier);
}

export circuit get_version(): Bytes<32> {
    const key = pad(32, "version");
    const current = versions.member(key) ? versions.lookup(key) : 0 as Uint<64>;
    const next = (current + 1) as Uint<64>;
    versions.insert(key, next);
    return persistent_hash<Vector<2, Bytes<32>>>([key, pad(32, "v")]);
}

export circuit registerDocument(
    documentHash: Bytes<32>,
    documentType: DocumentType,
    ownerDID: Bytes<32>,
    multiParty: Field,
    requiredSignatures: Uint<64>
): [] {
    assert documentHash != pad(32, "") "Invalid document hash";
    assert !documents.member(documentHash) "Document already registered";
    
    // Create commitment for owner DID
    const ownerCommitment = commit_to_did(ownerDID);
    
    documents.insert(documentHash, DocumentMetadata {
        documentType: documentType,
        ownerCommitment: ownerCommitment,
        multiParty: multiParty,
        requiredSignatures: requiredSignatures,
        signerCount: 0 as Uint<64>,
        version: 1 as Uint<8>
    });
    
    signerCounts.insert(documentHash, 0 as Uint<64>);
    get_version();
    return [];
}

export circuit generate_signature_proof(
    documentHash: Bytes<32>,
    signerDID: Bytes<32>
): Bytes<32> {
    const sk = local_secret_key();
    const signerCommitment = commit_to_did(signerDID);
    const nullifier = generate_nullifier(signerDID, documentHash);
    
    // Generate ZK proof that signer has valid DID without revealing it
    const proof = persistent_hash<Vector<4, Bytes<32>>>([
        documentHash,
        signerCommitment,
        nullifier,
        sk
    ]);
    return disclose(proof);
}

export circuit verify_signature_proof(
    documentHash: Bytes<32>,
    signerCommitment: Bytes<32>,
    proof: Bytes<32>,
    nullifierHash: Bytes<32>
): Field {
    // Verify proof without revealing signer DID
    const sk = local_secret_key();
    const expected = persistent_hash<Vector<4, Bytes<32>>>([
        documentHash,
        signerCommitment,
        nullifierHash,
        sk
    ]);
    return disclose(proof == expected ? 1 : 0);
}

export circuit signDocument(
    documentHash: Bytes<32>,
    signerDID: Bytes<32>,
    proof: Bytes<32>
): [] {
    assert documents.member(documentHash) "Document not found";
    assert !revoked.member(documentHash) "Document is revoked";
    
    const doc = documents.lookup(documentHash);
    
    // Generate commitment and nullifier
    const signerCommitment = commit_to_did(signerDID);
    const nullifier = generate_nullifier(signerDID, documentHash);
    const nullifierHash = persistent_hash<Vector<2, Bytes<32>>>([pad(32, "nh:"), nullifier]);
    
    // Ensure nullifier hasn't been used
    assert !nullifiers.member(nullifierHash) "Signature already exists";
    
    if (doc.multiParty != 0) {
        assert doc.signerCount < doc.requiredSignatures "All required signatures collected";
    }
    
    const timestamp = get_version();
    const currentCount = signerCounts.lookup(documentHash);
    const newCount = (currentCount + 1) as Uint<64>;
    
    // Record nullifier to prevent double-signing
    nullifiers.insert(nullifierHash);
    
    // Store signature with commitments instead of raw DIDs
    signatures.insert(nullifierHash, SignatureEntry {
        documentHash: documentHash,
        signerCommitment: signerCommitment,
        proof: proof,
        nullifierHash: nullifierHash,
        timestamp: timestamp
    });
    
    // Update signer count
    signerCounts.insert(documentHash, newCount);
    
    // Update document metadata
    documents.insert(documentHash, DocumentMetadata {
        documentType: doc.documentType,
        ownerCommitment: doc.ownerCommitment,
        multiParty: doc.multiParty,
        requiredSignatures: doc.requiredSignatures,
        signerCount: newCount,
        version: doc.version
    });
    
    return [];
}

export circuit revokeDocument(
    documentHash: Bytes<32>,
    ownerDID: Bytes<32>
): [] {
    assert documents.member(documentHash) "Document not found";
    assert !revoked.member(documentHash) "Document already revoked";
    
    const doc = documents.lookup(documentHash);
    
    // Verify ownership through commitment
    const ownerCommitment = commit_to_did(ownerDID);
    assert doc.ownerCommitment == ownerCommitment "Not document owner";
    
    revoked.insert(documentHash);
    get_version();
    return [];
}

export circuit verifySignatures(documentHash: Bytes<32>): Field {
    assert documents.member(documentHash) "Document not found";
    const doc = documents.lookup(documentHash);
    
    if (doc.multiParty != 0) {
        return disclose(doc.signerCount >= doc.requiredSignatures ? 1 : 0);
    }
    return disclose(doc.signerCount > 0 ? 1 : 0);
}