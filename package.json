{
  "name": "sig-verify-on-midnight",
  "version": "0.1.0",
  "description": "Privacy-preserving document signing platform on Midnight Network",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:watch": "vitest watch",
    "compile:contracts": "compactc src/contracts/did/did_registry.compact src/contracts/did/managed/did_registry && compactc src/contracts/signatures/signature_verification.compact src/contracts/signatures/managed/signature_verification",
    "compile:ts": "tsc --project tsconfig.build.json",
    "deploy:contracts": "NODE_OPTIONS='--loader ts-node/esm' ts-node scripts/deploy-contracts.ts",
    "deploy:testnet": "npm run compile:contracts && npm run deploy:contracts",
    "test:contracts": "vitest --config vitest.config.ts --testMatch '**/tests/integration/**/*.test.ts'"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@midnight-ntwrk/compact-runtime": "^0.7.0",
    "@midnight-ntwrk/ledger": "^3.0.6",
    "@midnight-ntwrk/midnight-js-contracts": "^0.2.5",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^0.2.5",
    "@midnight-ntwrk/midnight-js-network-id": "^0.2.5",
    "@midnight-ntwrk/midnight-js-types": "^0.2.5",
    "@midnight-ntwrk/zswap": "^3.0.6",
    "@mui/icons-material": "^6.4.6",
    "@mui/material": "^6.4.6",
    "axios": "^1.6.7",
    "circomlib": "^2.0.5",
    "crypto-js": "^4.2.0",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/chai": "^5.0.1",
    "@types/crypto-js": "^4.2.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "ignore-loader": "^0.1.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^0.25.3"
  }
}
