pragma language_version >= 0.14.0;

import CompactStandardLibrary;

// Document types enumeration
enum DocumentType {
    Basic,
    Legal,
    Regulated
}

// Signature structure
struct SignatureRecord {
    signer: Bytes<32>,           // DID of the signer
    document: Bytes<32>,         // Hash of the document
    signature: Bytes<32>,        // Signature hash
    timestamp: Field,            // When the signature was created
    doc_type: DocumentType       // Type of document
}

// Ledger state
ledger signatures: Map<Bytes<32>, SignatureRecord>;  // Map of document hash to signature
ledger kyc_levels: Map<Bytes<32>, Uint<8>>;         // Map of DID to KYC level
ledger admin: Bytes<32>;
ledger sigCounter: Counter;

witness local_secret_key(): Bytes<32>;

export circuit generate_key_proof(instance: Bytes<32>): Bytes<32> {
    const sk = local_secret_key();
    const proof = persistent_hash<Vector<3, Bytes<32>>>([pad(32, "sig:pk:"), instance, sk]);
    return disclose(proof);
}

// Admin management
export circuit set_admin(new_admin: Bytes<32>): [] {
    const current_proof = generate_key_proof(sigCounter as Field as Bytes<32>);
    assert admin == pad(32, "") || admin == current_proof
        "Only current admin can set new admin";
    admin = new_admin;
    return [];
}

// Sign a document
export circuit sign_document(doc: Bytes<32>, did: Bytes<32>, doc_type: DocumentType): [] {
    // Check document not already signed
    assert !signatures.member(doc)
        "Document already signed";

    // Check KYC level is sufficient
    const kyc_level = kyc_levels.lookup(did);
    assert kyc_level >= (doc_type as Field) as Uint<8>
        "Insufficient KYC level";

    // Get user's secret key via witness
    const sk = local_secret_key();
    const pk = persistent_hash<Vector<3, Bytes<32>>>([pad(32, "sig:pk:"), sigCounter as Field as Bytes<32>, sk]);

    // Verify DID ownership
    assert pk == did
        "DID verification failed";

    // Generate signature
    const sig = persistent_hash<Vector<4, Bytes<32>>>([pad(32, "sig:sign:"), doc, did, sigCounter as Field as Bytes<32>]);

    // Create signature record
    const record = SignatureRecord {
        signer: did,
        document: doc,
        signature: sig,
        timestamp: sigCounter as Field,
        doc_type: doc_type
    };

    // Update state
    signatures.insert(doc, record);
    sigCounter.increment(1);

    return [];
}

// Commit to DID
export circuit commit_to_did(did: Bytes<32>): Bytes<32> {
    const sk = local_secret_key();
    const proof = persistent_hash<Vector<3, Bytes<32>>>([pad(32, "sig:commit:"), did, sk]);
    return disclose(proof);
}

// Verify a signature
export circuit verify_signature(doc: Bytes<32>): Field {
    assert signatures.member(doc)
        "Document not signed";
    return 1;
}
